# EasyClaw Browser-VNC Template Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED: OpenClaw Gateway Configuration
# ============================================
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_TOKEN=your-secure-gateway-token-here
OPENCLAW_GATEWAY_BIND=lan
OPENCLAW_GATEWAY_TAILSCALE_MODE=serve
OPENCLAW_GATEWAY_ALLOW_TAILSCALE_AUTH=true
OPENCLAW_GATEWAY_ALLOW_INSECURE_AUTH=true
OPENCLAW_GATEWAY_ALLOWED_ORIGINS=https://api.easyclaw.ai,http://localhost:3001

# ============================================
# REQUIRED: Browser VNC Configuration
# ============================================
# VNC password - auto-generated by EasyClaw backend
VNC_PASSWORD=your-secure-vnc-password

# Public port for noVNC web interface (should match VNC port allocation)
NOVNC_PORT=6080

# ============================================
# AI Provider API Keys (at least one required)
# ============================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
KIMI_API_KEY=
OPENCODE_API_KEY=
MINIMAX_API_KEY=
MOONSHOT_API_KEY=

# ============================================
# Optional: Integrations
# ============================================
TELEGRAM_BOT_TOKEN=
GITHUB_TOKEN=
GITHUB_USERNAME=
GITHUB_EMAIL=

# ============================================
# Optional: Public Access
# ============================================
CF_TUNNEL_TOKEN=
