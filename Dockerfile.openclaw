# syntax=docker/dockerfile:1
# OpenClaw Gateway Service - Minimal

FROM node:lts-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

# Install essential tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    jq \
    openssl \
    ca-certificates \
    netcat-traditional \
    && rm -rf /var/lib/apt/lists/*

# Set up workspace
WORKDIR /app

# Install OpenClaw globally (with retry for transient registry/network issues)
RUN set -eux; \
    npm config set fetch-retries 5; \
    npm config set fetch-retry-mintimeout 20000; \
    npm config set fetch-retry-maxtimeout 120000; \
    npm config set fetch-timeout 300000; \
    attempt=1; \
    max_attempts=3; \
    until npm install -g openclaw --no-progress; do \
      if [ "$attempt" -ge "$max_attempts" ]; then \
        echo "❌ openclaw install failed after ${max_attempts} attempts"; \
        exit 1; \
      fi; \
      echo "⚠️ openclaw install attempt ${attempt} failed, retrying..."; \
      attempt=$((attempt + 1)); \
      sleep 10; \
    done; \
    command -v openclaw >/dev/null 2>&1; \
    echo "✅ openclaw installed"

# Copy bootstrap script
COPY scripts/bootstrap.sh /app/scripts/bootstrap.sh
COPY scripts/workspace-files.sh /app/scripts/workspace-files.sh
RUN chmod +x /app/scripts/bootstrap.sh /app/scripts/workspace-files.sh

# Set environment
ENV HOME=/data \
    OPENCLAW_STATE_DIR=/data/.openclaw \
    OPENCLAW_WORKSPACE=/data/openclaw-workspace

# Expose gateway port (documentation only)
EXPOSE 18789

# Run bootstrap and start
CMD ["bash", "/app/scripts/bootstrap.sh"]
